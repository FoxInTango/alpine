PREPARE_TARGETS += prepare.tango
PREPARE_URL_tango = wf@allinone.io:alpine/tango.git
PREPARE_DIR_tango = $(DEPENDS_APPLICATION_PATH)/$(basename $(notdir $(PREPARE_URL_tango)))
prepare.tango:
	-git clone $(PREPARE_URL_tango) $(PREPARE_DIR_tango)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_tango)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_tango)/.make/super
	-cd $(PREPARE_DIR_tango) && make prepare
	-rm $(PREPARE_DIR_tango)/.make/super
