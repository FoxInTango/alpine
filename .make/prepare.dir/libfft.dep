PREPARE_TARGETS += prepare.libfft
PREPARE_URL_libfft = https://github.com/FoxInTango/libfft.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libfft = wf@allinone.io:alpine/libfft.git
endif
PREPARE_DIR_libfft = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libfft)))
prepare.libfft:
	-git clone $(PREPARE_URL_libfft) $(PREPARE_DIR_libfft)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libfft)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libfft)/.make/super
	-cd $(PREPARE_DIR_libfft) && make prepare
	-rm $(PREPARE_DIR_libfft)/.make/super
