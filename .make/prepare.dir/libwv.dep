PREPARE_TARGETS += prepare.libwv
PREPARE_URL_libwv = https://github.com/FoxInTango/libwv.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libwv = wf@allinone.io:alpine/libwv.git
endif
PREPARE_DIR_libwv = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libwv)))
prepare.libwv:
	-git clone $(PREPARE_URL_libwv) $(PREPARE_DIR_libwv)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libwv)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libwv)/.make/super
	-cd $(PREPARE_DIR_libwv) && make prepare
	-rm $(PREPARE_DIR_libwv)/.make/super
