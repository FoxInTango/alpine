PREPARE_TARGETS += prepare.lib3d
PREPARE_URL_lib3d = https://github.com/FoxInTango/lib3d.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_lib3d = wf@allinone.io:alpine/lib3d.git
endif
PREPARE_DIR_lib3d = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_lib3d)))
prepare.lib3d:
	-git clone $(PREPARE_URL_lib3d) $(PREPARE_DIR_lib3d)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_lib3d)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_lib3d)/.make/super
	-cd $(PREPARE_DIR_lib3d) && make prepare
	-rm $(PREPARE_DIR_lib3d)/.make/super
