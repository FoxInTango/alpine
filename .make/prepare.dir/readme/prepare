ifdef SUPER_MAKE_CONFIG_DIR
ifdef ROOT_MAKE_CONFIG_DIR
        ifeq (${SUPER_MAKE_CONFIG_DIR},${ROOT_MAKE_CONFIG_DIR})
            -rm $(ROOT_MAKE_CONFIG_DIR)/$(TARGET_NAME).mk
            prepare.1
        endif
        ifneq (${SUPER_MAKE_CONFIG_DIR},${ROOT_MAKE_CONFIG_DIR})
