PREPARE_TARGETS += prepare.pugixml
PREPARE_URL_pugixml = https://github.com/zeux/pugixml.git
PREPARE_DIR_pugixml = $(DEPENDS_THIRDS_PATH)/$(basename $(notdir $(PREPARE_URL_pugixml)))
prepare.pugixml:
	-git clone $(PREPARE_URL_pugixml) $(PREPARE_DIR_pugixml)

