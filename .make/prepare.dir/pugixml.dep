PREPARE_TARGETS += prepare.pugixml
PREPARE_URL_pugixml = https://github.com/zeux/pugixml.git
PREPARE_DIR_pugixml = $(DEPENDS_THIRD_PATH)/$(basename $(notdir $(PREPARE_URL_pugixml)))
prepare.pugixml:
	-git clone https://github.com/FoxInTango/makeIt.git       $(PREPARE_DIR_pugixml) 
	-git clone $(PREPARE_URL_pugixml)                         $(PREPARE_DIR_pugixml)/pugixml
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_pugixml)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_pugixml)/.make/super
ifneq ($(wildcard $(PREPARE_DIR_pugixml)/.make/third),)
	-rm $(PREPARE_DIR_pugixml)/.make/third
endif
	-echo "TARGET_NAME=libpugixml"                                                                                                        >> $(PREPARE_DIR_pugixml)/.make/third
	-echo "THIRD_TARGETS:"                                                                                                                >> $(PREPARE_DIR_pugixml)/.make/third
	-echo "	mkdir $(PREPARE_DIR_pugixml)/build ;  cd $(PREPARE_DIR_pugixml)/build && cmake ../pugixml -DBUILD_SHARED_LIBS=on && make"     >> $(PREPARE_DIR_pugixml)/.make/third
	-echo "	-cp $(PREPARE_DIR_pugixml)/build/lib* $(PREPARE_DIR_pugixml)/lib"                                                             >> $(PREPARE_DIR_pugixml)/.make/third
	-echo "	-cp $(PREPARE_DIR_pugixml)/pugixml/src/*.hpp  $(PREPARE_DIR_pugixml)/inc"                                                     >> $(PREPARE_DIR_pugixml)/.make/third
	-cd $(PREPARE_DIR_pugixml) && make prepare
	-rm $(PREPARE_DIR_pugixml)/.make/super
