PREPARE_TARGETS += preapre.nlohmannjson
PREPARE_URL_nlohmannjson = https://github.com/nlohmann/json
PREPARE_DIR_nlohmannjson = $(DEPENDS_THIRD_PATH)/$(basename $(notdir $(PREPARE_URL_nlohmann)))
preapre.nlohmannjson:
	-git clone $(PREPARE_URL_nlohmannjson) $(PREPARE_DIR_nlohmannjson)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_nlohmannjson)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_nlohmannjson)/.make/super
	-cd $(PREPARE_DIR_nlohmannjson) && make prepare
	-rm $(PREPARE_DIR_nlohmannjson)/.make/super
