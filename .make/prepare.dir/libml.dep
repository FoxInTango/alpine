PREPARE_TARGETS += prepare.libml
PREPARE_URL_libml = wf@allinone.io:alpine/libml.git
PREPARE_DIR_libml = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libml)))
prepare.libml:
	-git clone $(PREPARE_URL_libml) $(PREPARE_DIR_libml)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libml)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libml)/.make/super
	-cd $(PREPARE_DIR_libml) && make prepare
	-rm $(PREPARE_DIR_libml)/.make/super
