PREPARE_TARGETS += prepare.libsystem
PREPARE_URL_libsystem = https://github.com/FoxInTango/libsystem.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libsystem = wf@allinone.io:alpine/libsystem.git
endif
PREPARE_DIR_libsystem = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libsystem)))
prepare.libsystem:
	-git clone $(PREPARE_URL_libsystem) $(PREPARE_DIR_libsystem)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libsystem)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libsystem)/.make/super
	-cd $(PREPARE_DIR_libsystem) && make prepare
	-rm $(PREPARE_DIR_libsystem)/.make/super
