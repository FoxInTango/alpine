PREPARE_TARGETS += prepare.libgl
PREPARE_URL_libgl = https://github.com/FoxInTango/libgl.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libgl = wf@allinone.io:alpine/libgl.git
endif
PREPARE_DIR_libgl = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libgl)))
prepare.libgl:
	-git clone $(PREPARE_URL_libgl) $(PREPARE_DIR_libgl)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libgl)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libgl)/.make/super
	-cd $(PREPARE_DIR_libgl) && make prepare
	-rm $(PREPARE_DIR_libgl)/.make/super
