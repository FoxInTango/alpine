PREPARE_TARGETS += prepare.libvm
PREPARE_URL_libvm = https://github.com/FoxInTango/libvm.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libvm = wf@allinone.io:alpine/libvm.git
endif
PREPARE_DIR_libvm = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libvm)))
prepare.libvm:
	-git clone $(PREPARE_URL_libvm) $(PREPARE_DIR_libvm)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libvm)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libvm)/.make/super
	-cd $(PREPARE_DIR_libvm) && make prepare
	-rm $(PREPARE_DIR_libvm)/.make/super
