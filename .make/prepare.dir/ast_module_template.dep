PREPARE_TARGETS += prepare.ast_module_template
PREPARE_URL_ast_module_template = wf@allinone.io:alpine/ast_module_template.git
PREPARE_DIR_ast_module_template = $(DEPENDS_TEMPLATE_PATH)/$(basename $(notdir $(PREPARE_URL_ast_module_template)))
prepare.ast_module_template:
	-git clone $(PREPARE_URL_ast_module_template) $(PREPARE_DIR_ast_module_template)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_ast_module_template)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_ast_module_template)/.make/super
	-cd $(PREPARE_DIR_ast_module_template) && make prepare
	-rm $(PREPARE_DIR_ast_module_template)/.make/super
