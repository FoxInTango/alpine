PREPARE_TARGETS += prepare.libcl
PREPARE_URL_libcl = wf@allinone.io:alpine/libcl.git
PREPARE_DIR_libcl = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libcl)))
prepare.libcl:
	-git clone $(PREPARE_URL_libcl) $(PREPARE_DIR_libcl)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libcl)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libcl)/.make/super
	-cd $(PREPARE_DIR_libcl) && make prepare
	-rm $(PREPARE_DIR_libcl)/.make/super
