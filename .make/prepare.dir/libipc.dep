PREPARE_TARGETS += prepare.libipc
PREPARE_URL_libipc = https://github.com/FoxInTango/libipc.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libipc = wf@allinone.io:alpine/libipc.git
endif
PREPARE_DIR_libipc = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libipc)))
prepare.libipc:
	-git clone $(PREPARE_URL_libipc) $(PREPARE_DIR_libipc)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libipc)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libipc)/.make/super
	-cd $(PREPARE_DIR_libipc) && make prepare
	-rm $(PREPARE_DIR_libipc)/.make/super
