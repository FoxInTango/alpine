PREPARE_TARGETS += prepare.libtls
PREPARE_URL_libtls = https://github.com/FoxInTango/libtls.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libtls = wf@allinone.io:alpine/libtls.git
endif
PREPARE_DIR_libtls = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libtls)))
prepare.libtls:
	-git clone $(PREPARE_URL_libtls) $(PREPARE_DIR_libtls)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libtls)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libtls)/.make/super
	-cd $(PREPARE_DIR_libtls) && make prepare
	-rm $(PREPARE_DIR_libtls)/.make/super
