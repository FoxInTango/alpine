PREPARE_TARGETS += prepare.libhttp
PREPARE_URL_libhttp = https://github.com/FoxInTango/libhttp.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libhttp = wf@allinone.io:alpine/libhttp.git
endif
PREPARE_DIR_libhttp = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libhttp)))
prepare.libhttp:
	-git clone $(PREPARE_URL_libhttp) $(PREPARE_DIR_libhttp)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libhttp)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libhttp)/.make/super
	-cd $(PREPARE_DIR_libhttp) && make prepare
	-rm $(PREPARE_DIR_libhttp)/.make/super
