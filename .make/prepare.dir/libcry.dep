PREPARE_TARGETS += prepare.libcry
PREPARE_URL_libcry = https://github.com/FoxInTango/libcry.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libcry = wf@allinone.io:alpine/libcry.git
endif
PREPARE_DIR_libcry = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libcry)))
prepare.libcry:
	-git clone $(PREPARE_URL_libcry) $(PREPARE_DIR_libcry)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libcry)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libcry)/.make/super
	-cd $(PREPARE_DIR_libcry) && make prepare
	-rm $(PREPARE_DIR_libcry)/.make/super
