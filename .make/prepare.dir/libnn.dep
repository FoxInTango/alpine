PREPARE_TARGETS += prepare.libnn
PREPARE_URL_libnn = https://github.com/FoxInTango/libnn.git
ifdef REMOTE_ALL_IN_ONE
PREPARE_URL_libnn = wf@allinone.io:alpine/libnn.git
endif
PREPARE_DIR_libnn = $(DEPENDS_LIBRARY_PATH)/$(basename $(notdir $(PREPARE_URL_libnn)))
prepare.libnn:
	-git clone $(PREPARE_URL_libnn) $(PREPARE_DIR_libnn)
	-echo "SUPER_MAKE_DIR=${MAKE_FILE_DIR}"                >> $(PREPARE_DIR_libnn)/.make/super
	-echo "SUPER_MAKE_CONFIG_DIR=${MAKE_CONFIG_DIR}"       >> $(PREPARE_DIR_libnn)/.make/super
	-cd $(PREPARE_DIR_libnn) && make prepare
	-rm $(PREPARE_DIR_libnn)/.make/super
