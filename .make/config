MK_FALSE = 0
MK_TRUE  = 1
TARGET_NAME     = alpine
TARGET_TYPE_BIN = $(MK_TRUE)
TARGET_TYPE_LIB = $(MK_FALSE)
TARGET_TYPE_DLL = $(MK_FALSE)

CONFIG_FLAGS_AS = -O3
CONFIG_FLAGS_CC = -O3 -c -fPIC -Wall -std=c11
CONFIG_FLAGS_PP = -O3 -c -fPIC -Wall -std=c++11 -fvisibility=hidden
CONFIG_FLAGS_AR = -O3
CONFIG_FLAGS_LD = -O3

# libs to be linked with.
CONFIG_LINK_WITH_LIBS      += -lsystem -lmodel -les -last -lvk -larguments -lmodule -lstring -lcpp 
CONFIG_LINK_WITH_LIBS      += -lshaderc -lvulkan -lwayland-server -lwayland-client -lseat -lxcb-ewmh -lxcb -linput -ludev -lgbm -lEGL -lktx -ldrm -lstdc++ 
CONFIG_HEADER_SEARCH_DIRS  += -I/usr/include -I/usr/local/include
CONFIG_LIBRARY_SEARCH_DIRS += -L/usr/lib -L/usr/local/lib
CONFIG_SOURCE_ROOT_DIRS    += ./src


# For example
SOURCE_DIR_BESIDES  = \(
SOURCE_DIR_BESIDES +=    -path ${SOURCE_ROOT_DIRS}/.git
SOURCE_DIR_BESIDES += -o -path ${SOURCE_ROOT_DIRS}/.make
SOURCE_DIR_BESIDES += \)

# [ROOT only] Path Configurations
HEADER_INSTALL_PATH      = ${MAKE_FILE_DIR}inc
BINARY_INSTALL_PATH      = ${MAKE_FILE_DIR}bin
LIBRARY_INSTALL_PATH     = ${MAKE_FILE_DIR}lib
DEPENDS_LIBRARY_PATH     = ${MAKE_FILE_DIR}libraries
DEPENDS_THIRDS_PATH      = ${MAKE_FILE_DIR}thirds
DEPENDS_APPLICATION_PATH = ${MAKE_FILE_DIR}applications

CONFIG_HEADER_SEARCH_DIRS  += -I${HEADER_INSTALL_PATH}
CONFIG_LIBRARY_SEARCH_DIRS += -L${LIBRARY_INSTALL_PATH}

# [ROOT only]  -- include $(MAKE_CONFIG_DIR)/root 
export ROOT_MAKE_DIR        = $(MAKE_FILE_DIR)
export ROOT_MAKE_CONFIG_DIR = $(MAKE_FILE_DIR).make
