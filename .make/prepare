PREPARE_TARGETS += preapre.mit
PREPARE_TARGETS += preapre.tango

PREPARE_TARGETS += preapre.libcpp
PREPARE_TARGETS += preapre.libstring
PREPARE_TARGETS += preapre.libmodel

ALPINE_APPLICATION_PATH=$(MAKE_FILE_DIR)applications
## mit
PREPARE_MIT_URL = wf@allinone.io:alpine/mit.git
PREPARE_MIT_DIR = $(ALPINE_APPLICATION_PATH)/$(basename $(notdir $(PREPARE_MIT_URL)))
preapre.mit:
	-git clone $(PREPARE_MIT_URL) $(PREPARE_MIT_DIR)
	-cd $(PREPARE_MIT_DIR) && $(MAKE) prepare

