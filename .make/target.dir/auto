PLATFORM_ARCH         = $(shell uname -s)
PLATFORM_ARCH_LINUX   = Linux
PLATFORM_ARCH_DARWIN  = Darwin
PLATFORM_ARCH_FREEBSD = FreeBSD

#    Output Name Extensions
TARGET_BIN_EXT = 
TARGET_LIB_EXT_STATIC  =
TARGET_LIB_EXT_DYNAMIC = 

ifeq (${PLATFORM_ARCH},${PLATFORM_ARCH_DARWIN})
    CC=gcc
    PP=g++
    AS=as
    AR=ar
    LD=ld
    TARGET_BIN_EXT         :=
    TARGET_LIB_EXT_STATIC  := .a
    TARGET_LIB_EXT_DYNAMIC := .dylib
    TARGET_FLAGS_AS = -O3
    TARGET_FLAGS_CC = -O3 -c -fPIC -Wall -std=c11   -DPLATFORM_DARWIN -DPLATFORM_DARWIN_API
    TARGET_FLAGS_PP = -O3 -c -fPIC -Wall -std=c++11 -DPLATFORM_DARWIN -DPLATFORM_DARWIN_API -fvisibility=hidden
    TARGET_FLAGS_AR = -O3
    TARGET_FLAGS_LD = -O3
endif
ifeq (${PLATFORM_ARCH},${PLATFORM_ARCH_LINUX})
    CC=gcc
    PP=g++
    AS=as
    AR=ar
    LD=ld
    TARGET_BIN_EXT         :=
    TARGET_LIB_EXT_STATIC  := .a
    TARGET_LIB_EXT_DYNAMIC := .so
    TARGET_FLAGS_AS = -O3
    TARGET_FLAGS_CC = -O3 -c -fPIC -Wall -std=c11   -DPLATFORM_LINUX -DPLATFORM_LINUX_API
    TARGET_FLAGS_PP = -O3 -c -fPIC -Wall -std=c++11 -DPLATFORM_LINUX -DPLATFORM_LINUX_API -fvisibility=hidden
    TARGET_FLAGS_AR = -O3
    TARGET_FLAGS_LD = -O3 
    TARGET_LINK_WITH_LIBS += -lshaderc -lvulkan -lwayland-server -lwayland-client -lseat -lxcb -linput -ludev -lgbm -lEGL -ldrm
endif
ifeq (${PLATFORM_ARCH},${PLATFORM_ARCH_FreeBSD})
    CC=gcc
    PP=g++
    AS=as
    AR=ar
    LD=ld
    TARGET_BIN_EXT         := 
    TARGET_LIB_EXT_STATIC  := .a
    TARGET_LIB_EXT_DYNAMIC := .so
    TARGET_FLAGS_AS = -O3
    TARGET_FLAGS_CC = -O3 -c -fPIC -Wall -std=c11   -DPLATFORM_FreeBSD -DPLATFORM_FreeBSD_API
    TARGET_FLAGS_PP = -O3 -c -fPIC -Wall -std=c++11 -DPLATFORM_FreeBSD -DPLATFORM_FreeBSD_API -fvisibility=hidden
    TARGET_FLAGS_AR = -O3
    TARGET_FLAGS_LD = -O3
endif
